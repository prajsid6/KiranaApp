rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /shop-request-images/{requestId} {
      allow create: if requestId.matches('[A-Za-z0-9]{20}')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
